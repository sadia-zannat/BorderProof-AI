# Local demonstration only. NEVER commit a filled .env containing credentials.
APP_ENV=development
ENABLE_DEMO_SEED=1
# Must be >=12 characters. Replace value before you start demo mode.
DEMO_SEED_PASSWORD=REPLACE_WITH_YOUR_OWN_LONG_UNIQUE_DEMO_PASSWORD
COOKIE_SECURE=0
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000
NEXT_PUBLIC_API_BASE_URL=
API_INTERNAL_URL=http://127.0.0.1:8000
ENABLE_LOCAL_SIGNUP=1
OLLAMA_ENABLED=1
ALLOW_EXTERNAL_LLM=0
# Optional; by default app stores runtime/borderproof.sqlite3 inside root.
# DATABASE_URL=sqlite:////absolute/path/to/database.sqlite3

# V2 optional: ONLY EXPLANATORY LLM calls, never financial authorization or execution.
# Leave unset to use the reproducible deterministic agent.
# LLM_API_URL=https://your-provider.example/v1/chat/completions
# LLM_MODEL=your-authorized-model
# LLM_API_KEY=KEEP_SECRET_NOT_IN_REPO
# Disabled by default. Local Tesseract executable must be installed separately.
ENABLE_LOCAL_OCR=0

# V5.1 LOCAL FREE inference. No key required. Localhost only by default.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
# DO NOT enable remote endpoints unless HTTPS + explicit informed consent.
# ALLOW_REMOTE_OLLAMA=0
